{
  "name": "daily-quest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others -n web,db \"npm:dev:web\" \"npm:dev:db\"",
    "build": "next build",
    "start": "concurrently --kill-others -n web,db \"npm:start:web\" \"npm:dev:db\"",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write app features server scripts tests",
    "format:check": "prettier --check app features server scripts tests",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:db": "node scripts/json-server.cjs",
    "start:web": "next start --hostname 0.0.0.0",
    "test:api": "node --test tests/api.integration.cjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.11",
    "concurrently": "^10.0.6",
    "json-server": "^0.17.4",
    "lucide-react": "^0.468.0",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0"
  }
}
